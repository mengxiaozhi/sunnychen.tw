{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sunnychen-polis",
  "main": "src/sunny-worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/mcp",
      "/c/*",
      "/r/*",
      "/a/*",
      "/en",
      "/en/*",
      "/explore",
      "/guide"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION",
        "class_name": "Conversation"
      },
      {
        "name": "NEURON_COORDINATOR",
        "class_name": "NeuronCoordinator"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "SENSEMAKING_QUEUE",
        "queue": "sunnychen-polis-sensemaking"
      }
    ],
    "consumers": [
      {
        "queue": "sunnychen-polis-sensemaking",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 1
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Conversation"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "NeuronCoordinator"
      ]
    }
  ],
  "vars": {
    "SUNNY_ALLOWED_ORIGINS": "https://sunnychen.tw,http://localhost:4321",
    "SUNNY_SITE_URL": "https://sunnychen.tw"
  },
  "observability": {
    "enabled": false
  },
  "env": {
    "production": {
      "name": "sunnychen-polis",
      "durable_objects": {
        "bindings": [
          {
            "name": "CONVERSATION",
            "class_name": "Conversation"
          },
          {
            "name": "NEURON_COORDINATOR",
            "class_name": "NeuronCoordinator"
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "queues": {
        "producers": [
          {
            "binding": "SENSEMAKING_QUEUE",
            "queue": "sunnychen-polis-sensemaking"
          }
        ],
        "consumers": [
          {
            "queue": "sunnychen-polis-sensemaking",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 1
          }
        ]
      },
      "vars": {
        "SUNNY_ALLOWED_ORIGINS": "https://sunnychen.tw",
        "SUNNY_SITE_URL": "https://sunnychen.tw"
      }
    }
  },
  "account_id": "36ff5e232bfe09f5a2de48a444d9f547"
}
